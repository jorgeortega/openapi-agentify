      "suggestions": {
        "title": "List orders",
        "description": "Lists orders, filtered and paged with status, limit, cursor. Use it to find orders before acting on one. The response has orders, nextCursor.",
        "params": {
          "status": "Only orders with this status. One of: open, paid, refunded.",
          "cursor": "Where to continue from: the cursor the previous page returned (nextCursor). Leave it out for the first page."
