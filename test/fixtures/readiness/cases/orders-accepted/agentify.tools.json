    {
      "name": "createOrder",
      "enabled": false,
      "operation": "POST /v1/orders",
      "title": "Create order",
      "description": "Create order",
      "method": "POST",
      "path": "/v1/orders",
      "params": [],
      "body": {
        "arg": "body",
        "required": true,
        "contentType": "application/json"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "required": [
              "customer",
              "items"
            ],
            "properties": {
              "customer": {
                "type": "string",
                "format": "email"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "sku",
                    "qty"
                  ],
                  "properties": {
                    "sku": {
                      "type": "string",
                      "enum": [
                        "tea-green",
                        "tea-black",
                        "mug-blue",
                        "kettle-steel"
                      ]
                    },
                    "qty": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "body"
        ],
        "additionalProperties": false
      },
      "scope": "api:write",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "suggestions": {
        "operationId": "createOrder",
        "description": "Creates an order from the fields in the body and returns it. It changes data: send an Idempotency-Key so a retry doesn't create two. The response has id, customer, items, totalCents, status, createdAt.",
        "examples": [
          {
            "description": "Create an order",
            "arguments": {
              "body": {
                "customer": "ada@example.com",
                "items": [
                  {
                    "sku": "tea-green",
                    "qty": 1
                  }
                ]
              }
            }
          }
        ],
        "idempotencyKey": true,
        "source": "rules",
        "accepted": true
      }
    },
