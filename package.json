{
  "name": "openapi-agentify",
  "version": "0.1.0",
  "description": "Turn the API you already run into an MCP server: one middleware, from your OpenAPI spec, in-process. Express, Hono, Fastify and Next.js.",
  "license": "MIT",
  "author": "October Moon LLC",
  "homepage": "https://latitude10.tech/platform/mcp",
  "repository": "github:jorgeortega/openapi-agentify",
  "bugs": "https://github.com/jorgeortega/openapi-agentify/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "ai-agents",
    "llm",
    "express",
    "hono",
    "fastify",
    "nextjs",
    "middleware"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./express": {
      "types": "./dist/src/adapters/express.d.ts",
      "default": "./dist/src/adapters/express.js"
    },
    "./hono": {
      "types": "./dist/src/adapters/hono.d.ts",
      "default": "./dist/src/adapters/hono.js"
    },
    "./next": {
      "types": "./dist/src/adapters/next.d.ts",
      "default": "./dist/src/adapters/next.js"
    },
    "./fastify": {
      "types": "./dist/src/adapters/fastify.d.ts",
      "default": "./dist/src/adapters/fastify.js"
    },
    "./cli": {
      "types": "./dist/src/cli/main.d.ts",
      "default": "./dist/src/cli/main.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/src/index.d.ts",
  "bin": {
    "openapi-agentify": "./bin/openapi-agentify.mjs"
  },
  "files": [
    "dist/src",
    "bin",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p . && tsc -p examples/orders-api/next",
    "test": "vitest run",
    "test:watch": "vitest",
    "agentify": "tsx src/cli/main.ts",
    "demo:express": "tsx examples/orders-api/express/server.ts",
    "demo:hono": "tsx examples/orders-api/hono/server.ts",
    "demo:fastify": "tsx examples/orders-api/fastify/server.ts",
    "demo:next": "tsx examples/orders-api/next/server.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "express": ">=4.18.0",
    "fastify": ">=5.0.0",
    "hono": ">=4.6.0",
    "next": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express4": "npm:express@^4.22.3",
    "fastify": "^5.12.5",
    "helmet": "^8.3.0",
    "hono": "^4.13.11",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
